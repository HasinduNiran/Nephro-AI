{
  "expo": {
    "name": "Nephro-AI",
    "slug": "nephro-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": false
    },
    "icon": "./images/Nephro-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./images/splash screen nephro-AI.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nephroai.mobile"
    },
    "android": {
      "package": "com.nephroai.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["android.permission.health.READ_BLOOD_PRESSURE"],
      "adaptiveIcon": {
        "foregroundImage": "./images/Nephro-logo.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./images/Nephro-logo.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 34
          }
        }
      ],
      [
        "react-native-health-connect",
        {
          "requestPermissionsBackCompat": true
        }
      ],
      "./plugins/withAndroidCxxFix",
      "./plugins/withHealthConnectPermissions"
    ]
  }
}
