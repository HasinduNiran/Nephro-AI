{
  "name": "nephro-ai-backend",
  "version": "1.0.0",
  "description": "Backend for Nephro-AI Mobile App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "predev": "node -e \"const{execFileSync}=require('child_process'),p=require('path').join(process.env.LOCALAPPDATA,'Android','Sdk','platform-tools','adb.exe');try{execFileSync(p,['reverse','tcp:5000','tcp:5000'],{stdio:'inherit'});execFileSync(p,['reverse','tcp:8001','tcp:8001'],{stdio:'inherit'})}catch(e){console.log('adb reverse skipped')}\"",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^4.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
